@article{daleTwoparameterModelInfrared2014,
  title = {A {{Two-parameter Model}} for the {{Infrared}}/{{Submillimeter}}/{{Radio Spectral Energy Distributions}} of {{Galaxies}} and {{Active Galactic Nuclei}}},
